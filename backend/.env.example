FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:4200

# Exclusivamente Sandbox. Configurar ambas claves localmente; nunca en Angular.
FINTOC_SANDBOX_ENABLED=false
FINTOC_SECRET_KEY=
FINTOC_PUBLIC_KEY=

# Origen de Angular para los retornos del Checkout alojado. HTTPS fuera de localhost.
FINTOC_CHECKOUT_BASE_URL=http://localhost:4200
